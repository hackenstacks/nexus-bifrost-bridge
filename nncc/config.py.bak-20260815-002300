    rules_file: str = "bypass-rules.json"

    # Podman/Docker Configuration
    container_runtime: str = "podman"  # or "docker"
    socket_path: str = "/run/user/1000/podman/podman.sock"  # Rootless podman

    # Network Definitions (using localhost for host-network mode)
    # Container names match actual podman containers: nexus-tor, nexus-i2p, etc.
    networks: Dict[str, dict] = {
        "tor": {
            "name": "Tor",
            "icon": "🧅",
            "color": "#7B68EE",
            "containers": ["nexus-tor-*", "nexus-tor"],  # Multi-instance pattern + fallback
            "multi_instance": True,  # Flag for multi-instance detection
            "health_check": {
                "type": "socks",
                "host": "127.0.0.1",
                "port": 9050,
                "test_url": "https://check.torproject.org/api/ip"
            },
            "config": {
                "circuits": 6,  # TORS env var
                "heads": 2      # HEADS env var (Privoxy instances)
            }
        },
        "i2p": {
