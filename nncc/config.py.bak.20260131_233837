"""
NeXuS Command Center - Configuration
Central configuration for the network control API
"""

from pathlib import Path
from pydantic_settings import BaseSettings
from typing import List, Dict, Optional


class Settings(BaseSettings):
    """Application settings with environment variable support"""

    # Server Configuration
    host: str = "0.0.0.0"
    api_port: int = 8801
    ui_port: int = 8800
    debug: bool = False

    # Data Paths
    data_dir: Path = Path("/app/data")
    rules_file: str = "bypass-rules.json"

    # Podman/Docker Configuration
    container_runtime: str = "podman"  # or "docker"
    socket_path: str = "/run/podman/podman.sock"

    # Network Definitions
    networks: Dict[str, dict] = {
        "tor": {
            "name": "Tor",
            "icon": "🧅",
            "color": "#7B68EE",
            "containers": [
                "nexus-tor-01", "nexus-tor-02", "nexus-tor-03",
                "nexus-tor-04", "nexus-tor-05", "nexus-tor-06"
            ],
            "health_check": {
                "type": "socks",
                "host": "nexus-haproxy",
                "port": 9050,
                "test_url": "https://check.torproject.org/api/ip"
            }
        },
        "i2p": {
            "name": "I2P",
            "icon": "🟣",
            "color": "#9932CC",
            "containers": ["nexus-i2p"],
            "health_check": {
                "type": "http",
                "host": "nexus-i2p",
                "port": 7070,
                "path": "/"
            }
        },
        "yggdrasil": {
            "name": "Yggdrasil",
            "icon": "🟢",
            "color": "#32CD32",
            "containers": ["nexus-yggdrasil"],
            "health_check": {
                "type": "admin",
                "socket": "/var/run/yggdrasil.sock"
            }
        },
        "reticulum": {
            "name": "Reticulum",
            "icon": "🔴",
            "color": "#FF4500",
            "containers": ["nexus-reticulum"],
            "health_check": {
                "type": "rnstatus",
                "command": "rnstatus"
            }
        },
        "batman": {
            "name": "BATMAN-adv",
            "icon": "🦇",
            "color": "#2F4F4F",
            "containers": [],
            "health_check": {
                "type": "interface",
                "interface": "bat0"
            }
        },
        "direct": {
            "name": "Direct",
            "icon": "🔓",
            "color": "#FFD700",
            "containers": [],
            "health_check": {
                "type": "none"
            }
        }
    }

    # HAProxy Configuration
    haproxy_stats_url: str = "http://nexus-haproxy:8404/stats"
    haproxy_socket: str = "/var/run/haproxy/admin.sock"
    haproxy_config_path: str = "/etc/haproxy/haproxy.cfg"

    # Health Check Intervals
    health_check_interval: int = 30  # seconds
    traffic_poll_interval: float = 1.0  # seconds

    # WebSocket Configuration
    ws_heartbeat: int = 30
    ws_max_connections: int = 100

    class Config:
        env_prefix = "NEXUS_"
        env_file = ".env"


# Global settings instance
settings = Settings()


# Network container mapping for quick lookup
CONTAINER_TO_NETWORK = {}
for net_id, net_config in settings.networks.items():
    for container in net_config.get("containers", []):
        CONTAINER_TO_NETWORK[container] = net_id
