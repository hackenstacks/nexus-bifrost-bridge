        "ipfs": {
            "name": "IPFS",
            "icon": "📦",
            "color": "#65C2CB",
            "containers": ["nexus-ipfs"],
            "health_check": {
                "type": "http",
                "host": "127.0.0.1",
                "port": 5001,
                "path": "/api/v0/id"
            }
        },
        "snowflake": {
            "name": "Snowflake",
            "icon": "❄️",
            "color": "#87CEEB",
            "containers": ["nexus-snowflake"],
            "health_check": {
                "type": "tcp",
