                "port": 7070,
                "path": "/"
            }
        },
        "yggdrasil": {
            "name": "Yggdrasil",
            "icon": "🟢",
            "color": "#32CD32",
            "containers": ["nexus-yggdrasil"],
            "health_check": {
                "type": "tcp",
                "host": "127.0.0.1",
                "port": 9001
